# Home server deployment; compose project: automationnews
COMPOSE_PROJECT_NAME=automationnews
POSTGRES_USER=hub
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LETTERS_AND_NUMBERS
POSTGRES_DB=hub
DB_POOL_MAX=10
WEB_PORT=8091
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=
# Replace with your public HTTPS origin (without trailing slash).
APP_ORIGIN=https://news.example.com
REGISTRATION_OPEN=false
MAX_USERS=100
ACCOUNT_NTFY_URL=https://ntfy.sh/
OWNER_EMAIL=REPLACE_WITH_YOUR_EMAIL
CLAIM_LEGACY_DATA=false
GITHUB_TOKEN=
NTFY_TOKEN=
NTFY_AUTH_ORIGIN=
NTFY_ALLOWED_ORIGINS=
SCHEDULER_GRACE_MS=900000

# Optional image tag when deploying prebuilt image archives via infra/compose.premium.yaml
AUTOMATIONNEWS_IMAGE_TAG=latest

# Optional Premium payment configuration (authenticated API only; never commit real PII to Git)
PREMIUM_PRICE_TEXT=20.000 ₫
PREMIUM_BANK_NAME=Ngân hàng nhận chuyển khoản
PREMIUM_ACCOUNT_NAME=
PREMIUM_ACCOUNT_NUMBER=
PREMIUM_QR_URL=

# Add the release's private .env.premium with a second --env-file argument if separating AI keys.
NEWS_FREE_ONLY=false
NEWS_AI_KILL_SWITCH=false
NEWS_SEARCH_KILL_SWITCH=false
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=

# Isolated from BankingPrj; compose project: automationnews
POSTGRES_USER=hub
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LETTERS_AND_NUMBERS
POSTGRES_DB=hub
WEB_PORT=8091
# For temporary testing, replace with the current Quick Tunnel HTTPS origin.
APP_ORIGIN=https://news.020407.xyz
REGISTRATION_OPEN=false
MAX_USERS=100
ACCOUNT_NTFY_URL=https://ntfy.sh/
OWNER_EMAIL=REPLACE_WITH_YOUR_EMAIL
CLAIM_LEGACY_DATA=false
GITHUB_TOKEN=
NTFY_TOKEN=
NTFY_ALLOWED_ORIGINS=
SCHEDULER_GRACE_MS=900000
# Add the release's private .env.premium with a second --env-file argument.
# Its values override the defaults below for the Premium worker and API.
NEWS_FREE_ONLY=false
NEWS_AI_KILL_SWITCH=false
NEWS_SEARCH_KILL_SWITCH=false
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Provider model, budgets and search quotas are configured in Premium & AI.
# Only the worker receives provider keys. They are never shipped in source archives.

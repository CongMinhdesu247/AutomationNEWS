# Local development only. Choose a password before starting PostgreSQL.
POSTGRES_USER=hub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hub
DB_PORT=54329
DATABASE_URL=postgresql://hub:CHANGE_ME@127.0.0.1:54329/hub
HOST=127.0.0.1
PORT=3001
# Backend only; optional tokens. Never sent to the browser.
NTFY_TOKEN=

GITHUB_TOKEN=
# Optional phone-reachable HTTP(S) URL; omit for text-only notifications.
PUBLIC_BASE_URL=
# Exact ntfy origins allowed to use LAN/loopback (comma-separated); empty = public only.
NTFY_ALLOWED_ORIGINS=
HTTP_TIMEOUT_MS=6000
DIGEST_TIMEOUT_MS=25000
MAX_CONCURRENT_OPERATIONS=2

# Durable worker; heartbeat must be less than half the lease.
WORKER_CONCURRENCY=3
WORKER_LEASE_MS=15000
WORKER_HEARTBEAT_MS=4000
WORKER_POLL_MS=1000
WORKER_MAX_RECOVERIES=3
WORKER_SHUTDOWN_MS=10000

# Connector retries, separate from crash recovery. 3 retries after the first attempt.
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
# Daily scheduler; overdue occurrences older than grace are skipped.
SCHEDULER_POLL_MS=5000
SCHEDULER_GRACE_MS=900000

# Owner-only family cloud administration (API only)
HUB_CLOUD_REPOSITORY=
HUB_CLOUD_ADMIN_TOKEN=
HUB_ADMIN_ORIGIN=http://127.0.0.1:8088

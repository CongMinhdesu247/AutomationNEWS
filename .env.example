# Local development only. Set a strong unique password before starting PostgreSQL.
POSTGRES_USER=hub
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
POSTGRES_DB=hub
DB_PORT=54329
DB_POOL_MAX=10
# Optional alternate dashboard port when running an isolated second Compose project.
WEB_PORT=8088
DATABASE_URL=postgresql://hub:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:54329/hub
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=true
# Optional comma-separated trusted proxy CIDRs (defaults to loopback + RFC1918 private ranges when TRUST_PROXY=true).
TRUSTED_PROXY_CIDRS=
# Backend only; optional tokens. Never sent to the browser.
NTFY_TOKEN=
# Exact origin allowed to receive NTFY_TOKEN Bearer header (defaults to ACCOUNT_NTFY_URL origin when set).
NTFY_AUTH_ORIGIN=

GITHUB_TOKEN=
# Optional phone-reachable HTTP(S) URL; omit for text-only notifications.
PUBLIC_BASE_URL=
# Optional LAN/public URL for Family Member capability links.
MEMBER_PUBLIC_URL=
# Exact ntfy origins allowed to use LAN/loopback (comma-separated); empty = public only.
NTFY_ALLOWED_ORIGINS=
HTTP_TIMEOUT_MS=6000
DIGEST_TIMEOUT_MS=25000
MAX_CONCURRENT_OPERATIONS=2

# Durable worker; heartbeat must be less than half the lease.
WORKER_CONCURRENCY=3
WORKER_LEASE_MS=15000
WORKER_HEARTBEAT_MS=4000
WORKER_POLL_MS=1000
WORKER_MAX_RECOVERIES=3
WORKER_SHUTDOWN_MS=10000

# Connector retries, separate from crash recovery. 3 retries after the first attempt.
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
# Daily scheduler; overdue occurrences older than grace are skipped.
SCHEDULER_POLL_MS=5000
SCHEDULER_GRACE_MS=900000

# Owner-only family cloud administration (API only; use a repo-scoped fine-grained token)
HUB_CLOUD_REPOSITORY=
HUB_CLOUD_ADMIN_TOKEN=
HUB_ADMIN_ORIGIN=http://127.0.0.1:8088

# Exact browser origin without trailing slash. Vite dev: http://127.0.0.1:5173
APP_ORIGIN=http://127.0.0.1:8088
REGISTRATION_OPEN=false
MAX_USERS=100
ACCOUNT_NTFY_URL=https://ntfy.sh/
OWNER_EMAIL=

# Optional Premium bank transfer metadata (served only to authenticated users; never commit real PII/QR to Git)
PREMIUM_PRICE_TEXT=20.000 ₫
PREMIUM_BANK_NAME=Ngân hàng nhận chuyển khoản
PREMIUM_ACCOUNT_NAME=
PREMIUM_ACCOUNT_NUMBER=
PREMIUM_QR_URL=

## Premium beta: no provider calls until the admin explicitly configures a budget.
NEWS_AI_KILL_SWITCH=false
NEWS_SEARCH_KILL_SWITCH=false
NEWS_FREE_ONLY=true
# Backend worker & API availability check only. Never use a VITE_ prefix.
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
